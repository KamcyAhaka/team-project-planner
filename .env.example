# MongoDB Connection String
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/team_project_planner?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/team_project_planner

# Auth.js Secret Key (generate a random 32-byte secret, e.g. using `openssl rand -base64 32`)
AUTH_SECRET=your_auth_secret_key_here

# Base URL for NextAuth (default: http://localhost:3000 in development)
NEXTAUTH_URL=http://localhost:3000
